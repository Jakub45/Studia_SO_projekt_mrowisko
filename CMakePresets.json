{
  "version": 3,
  "configurePresets": [
    {
      "name": "wsl-debug",
      "displayName": "WSL GCC Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "wsl-debug",
      "configurePreset": "wsl-debug"
    }
  ]
}